# Banco de dados
POSTGRES_DB=raizes
POSTGRES_USER=raizes_user
POSTGRES_PASSWORD=raizes_pass
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/raizes

# Perfil ativo do Spring (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Segredo do JWT - precisa ter no minimo 32 bytes.
# Gere o seu com: openssl rand -base64 48
JWT_SECRET=troque-este-valor-por-um-segredo-de-no-minimo-32-bytes

# Fuso usado nas regras de negocio
APP_TIMEZONE=America/Sao_Paulo
