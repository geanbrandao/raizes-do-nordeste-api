flowchart LR
  classDef ok fill:#e8f5e9,stroke:#2e7d32,color:#000
  classDef erro fill:#ffebee,stroke:#c62828,color:#000
  classDef passo fill:#eaf1fb,stroke:#3b6fb5,color:#000
  classDef dec fill:#fff8e1,stroke:#f9a825,color:#000

  INI([Cliente monta o pedido]):::passo
  A1[POST /pedidos<br/>unidade, canal e itens]:::passo
  D1{Autenticado?}:::dec
  E1[401 NAO_AUTENTICADO]:::erro
  D2{canalPedido<br/>informado?}:::dec
  E2[400 REQUISICAO_INVALIDA]:::erro
  D3{quantidade<br/>maior que zero?}:::dec
  E3[422 VALIDACAO]:::erro
  D4{itens no cardapio<br/>desta unidade?}:::dec
  E4[422 PRODUTO_FORA_DO_CARDAPIO]:::erro
  D5{saldo suficiente<br/>para todos?}:::dec
  E5[409 ESTOQUE_INSUFICIENTE<br/>com a lista do que faltou<br/>nenhum pedido e criado]:::erro
  A2[Debita estoque<br/>e registra movimentacao]:::passo
  A3[Congela preco do cardapio<br/>em cada item]:::passo
  A4[Aplica campanha do canal,<br/>unidade e faixa de idade]:::passo
  A5[Grava pedido<br/>status AGUARDANDO_PAGAMENTO]:::passo
  A6[Registra PEDIDO_CRIADO<br/>na trilha, mesma transacao]:::passo
  R1([201 Created<br/>total calculado no servidor]):::ok

  INI --> A1 --> D1
  D1 -- nao --> E1
  D1 -- sim --> D2
  D2 -- nao --> E2
  D2 -- sim --> D3
  D3 -- nao --> E3
  D3 -- sim --> D4
  D4 -- nao --> E4
  D4 -- sim --> D5
  D5 -- nao --> E5
  D5 -- sim --> A2 --> A3 --> A4 --> A5 --> A6 --> R1

  R1 --> B1[POST /pedidos/id/pagamentos<br/>metodo e token]:::passo
  B1 --> D6{pedido ja pago?}:::dec
  D6 -- sim --> E6[409 PEDIDO_JA_PAGO]:::erro
  D6 -- nao --> D7{mesma chave de<br/>idempotencia?}:::dec
  D7 -- sim --> R2([201 com o mesmo pagamento<br/>nao cobra duas vezes]):::ok
  D7 -- nao --> B2[Chama o gateway]:::passo
  B2 --> D8{resposta}:::dec
  D8 -- APROVADO --> C1[pedido = PAGO]:::passo
  D8 -- RECUSADO --> C2([201 RECUSADO<br/>pedido = PAGAMENTO_RECUSADO<br/>da para tentar outro meio]):::erro
  D8 -- SEM RESPOSTA --> C3([201 PENDENTE<br/>pedido NAO avanca<br/>aguarda callback assinado]):::erro
  C1 --> D9{consentimento<br/>FIDELIDADE ativo?}:::dec
  D9 -- sim --> C4[Credita pontos]:::passo
  D9 -- nao --> C5[Nao pontua<br/>e nao falha o pagamento]:::passo
  C4 --> R3([201 APROVADO]):::ok
  C5 --> R3
